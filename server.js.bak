// konihaus subscriber viewer — tiny local server (binds to 127.0.0.1 only).
// Shows the signup lists and the promo-code usage log. Reads from S3 (if S3_BUCKET_NAME is set) or from local files.
const http = require("node:http");
const fs = require("node:fs");
const path = require("node:path");

try { process.loadEnvFile(path.join(__dirname, ".env")); } catch { /* .env is optional */ }

const PORT = Number(process.env.PORT || 3000);
// Same variable names as the Vercel app (S3_BUCKET_NAME, AWS_REGION, AWS_* credentials)
const BUCKET = process.env.S3_BUCKET_NAME || "";
const REGION = process.env.AWS_REGION || "eu-central-1";
// JSON files to show (comma-separated): landing page signups + blog newsletter signups
// The code-usage log (written by /api/getcode on the Vercel app) is always included.
const USAGES_FILE = process.env.S3_USAGES_KEY || "code-usages.json";
const FILES = [...new Set([...(process.env.S3_KEYS || "emails.json,blog-emails.json").split(",").map((s) => s.trim()).filter(Boolean), USAGES_FILE])];
const MODE = BUCKET ? "s3" : "local";

let s3;
async function readFile(name) {
  if (MODE === "s3") {
    const { S3Client, GetObjectCommand } = require("@aws-sdk/client-s3");
    s3 ??= new S3Client({ region: REGION });
    const out = await s3.send(new GetObjectCommand({ Bucket: BUCKET, Key: name }));
    return await out.Body.transformToString("utf-8");
  }
  return fs.readFileSync(path.join(__dirname, name), "utf-8");
}

const MIME = { ".html": "text/html", ".js": "text/javascript", ".css": "text/css", ".svg": "image/svg+xml" };

// UI is embedded so server.js works on its own (no public/ folder needed).
const ASSETS = {
 "index.html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>konihaus Subscribers</title>\n  <link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%232a4a35'/%3E%3Cpath d='M16 6 6 15h3v10h14V15h3z' fill='%23f7f4ed'/%3E%3C/svg%3E\">\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link href=\"https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <header>\n    <div class=\"brand\">\n      <div class=\"logo-image\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 320 320\" xmlns:c2pa=\"http://c2pa.org/manifest\">\n<g transform=\"translate(0,320) scale(0.1,-0.1)\" stroke=\"none\">\n<path fill=\"#ffffff\" d=\"M1545 3018 c-38 -22 -1420 -1230 -1437 -1256 -17 -25 -18 -75 -18\n-662 0 -708 0 -706 66 -806 20 -30 55 -69 78 -87 116 -92 140 -97 509 -97\nl299 0 34 34 c44 44 45 83 5 128 l-29 33 -314 5 c-303 5 -314 6 -349 27 -20\n13 -49 42 -65 65 l-29 43 -3 610 -2 610 642 560 c354 307 650 559 658 559 8 0\n304 -252 658 -559 l642 -560 -2 -610 -3 -610 -29 -43 c-16 -23 -45 -52 -65\n-65 -35 -21 -46 -22 -346 -27 -332 -5 -341 -7 -364 -57 -23 -49 -2 -110 44\n-131 41 -19 594 -16 668 3 92 24 175 84 231 169 66 100 66 98 66 806 -1 479\n-4 640 -13 657 -7 12 -32 39 -57 60 -25 22 -342 298 -706 615 -363 317 -670\n581 -682 587 -26 14 -61 14 -87 -1z M1047 1420 c-77 -24 -137 -108 -137 -192\n0 -60 36 -125 89 -163 37 -26 51 -30 110 -30 56 0 74 4 108 27 62 41 88 90 88\n168 0 77 -26 127 -85 166 -42 28 -126 40 -173 24z\"/>\n<path fill=\"#C47C2B\" d=\"M2007 1420 c-77 -24 -137 -108 -137 -192 0 -60 36 -125 89 -163 37\n-26 51 -30 110 -30 56 0 74 4 108 27 62 41 88 90 88 168 0 77 -26 127 -85 166\n-42 28 -126 40 -173 24z\"/>\n</g>\n</svg>\n</div>\n      <span class=\"wordmark\">konihaus</span>\n      <span class=\"tag\">Subscribers</span>\n    </div>\n    <div class=\"meta\"><span id=\"source\" class=\"pill\"></span><button id=\"refresh\" class=\"btn\">Refresh</button></div>\n  </header>\n\n  <main>\n    <nav id=\"files\" class=\"tabs\"></nav>\n    <section id=\"stats\" class=\"stats\"></section>\n\n    <section id=\"usageExtra\" class=\"extra hidden\">\n      <div class=\"card\">\n        <div class=\"card-head\">Visits per day · last 14 days</div>\n        <div id=\"dayBars\" class=\"bars\"></div>\n      </div>\n      <div class=\"card\">\n        <div class=\"card-head\">Per code <span class=\"hint\">(click a row to filter the log)</span></div>\n        <table><thead><tr><th>Code</th><th>Visits</th><th>Unique IPs</th><th>First</th><th>Last</th></tr></thead><tbody id=\"sumRows\"></tbody></table>\n        <p id=\"sumEmpty\" class=\"empty hidden\">No code usages recorded yet.</p>\n      </div>\n    </section>\n\n    <div class=\"toolbar\">\n      <div class=\"seg\" role=\"tablist\">\n        <button id=\"viewTable\" class=\"active\">Emails</button>\n        <button id=\"viewJson\">JSON</button>\n      </div>\n      <div id=\"tableTools\" class=\"tools\">\n        <input id=\"search\" type=\"search\" placeholder=\"Search email or IP…\">\n        <select id=\"lang\"><option value=\"\">All languages</option></select>\n        <button id=\"copy\" class=\"btn\">Copy emails</button>\n        <button id=\"csv\" class=\"btn\">CSV</button>\n      </div>\n      <button id=\"copyJson\" class=\"btn hidden\">Copy JSON</button>\n    </div>\n\n    <div id=\"error\" class=\"error hidden\"></div>\n    <div id=\"tableWrap\" class=\"card\"><table><thead><tr id=\"headRow\"></tr></thead><tbody id=\"rows\"></tbody></table><p id=\"empty\" class=\"empty hidden\">No matching entries.</p></div>\n    <pre id=\"json\" class=\"card hidden\"></pre>\n    <p id=\"status\" class=\"status\"></p>\n  </main>\n  <script src=\"app.js\"></script>\n</body>\n</html>\n",
 "style.css": ":root { --green:#2a4a35; --amber:#c47c2b; --parchment:#f7f4ed; --navy:#1a2f4a; --line:#e4dfd2; --card:#fff; }\n* { box-sizing: border-box; }\nbody { margin:0; font:15px/1.5 Outfit, system-ui, sans-serif; background:var(--parchment); color:var(--navy); }\nheader { display:flex; justify-content:space-between; align-items:center; padding:12px 24px; background:var(--green); color:var(--parchment); }\n.logo-image {\ndisplay: block;\nwidth: 36px;\nheight: 36px;\nbackground-size: contain;\n background-repeat: no-repeat;\n}\n.brand { display:flex; align-items:center; gap:10px; }\n.wordmark { font-size:20px; font-weight:500; letter-spacing:.2px; }\n.wordmark b { font-weight:600; color:var(--amber); }\n.tag { font-size:12px; opacity:.75; border-left:1px solid #ffffff44; padding-left:10px; margin-left:4px; }\n.meta { display:flex; gap:10px; align-items:center; }\n.pill { font-size:12px; padding:3px 10px; border-radius:99px; background:#ffffff1f; }\nmain { max-width:980px; margin:24px auto; padding:0 20px; }\n.tabs { display:flex; gap:6px; margin-bottom:14px; }\n.tabs:empty { display:none; }\n.tabs button { border:1px solid var(--line); background:transparent; padding:5px 12px; border-radius:6px; cursor:pointer; color:var(--navy); font:inherit; }\n.tabs button.active { background:var(--navy); color:#fff; border-color:var(--navy); }\n.stats { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:12px; margin-bottom:18px; }\n.stat { background:var(--card); border:1px solid var(--line); border-radius:10px; padding:12px 14px; }\n.stat .n { font-size:24px; font-weight:600; color:var(--green); }\n.stat .l { font-size:12px; color:#5b6674; }\n.toolbar { display:flex; gap:12px; align-items:center; flex-wrap:wrap; margin-bottom:12px; }\n.tools { display:flex; gap:8px; flex:1; flex-wrap:wrap; }\ninput, select, .btn { font:inherit; padding:6px 10px; border:1px solid var(--line); border-radius:6px; background:#fff; color:var(--navy); }\ninput[type=search] { flex:1; min-width:160px; }\n.btn { cursor:pointer; }\n.btn:hover { border-color:var(--amber); }\nheader .btn { background:transparent; color:var(--parchment); border-color:#ffffff55; }\n.seg { display:flex; border:1px solid var(--line); border-radius:6px; overflow:hidden; background:#fff; }\n.seg button { border:0; background:transparent; padding:6px 14px; cursor:pointer; font:inherit; color:var(--navy); }\n.seg button.active { background:var(--green); color:#fff; }\n.card { background:var(--card); border:1px solid var(--line); border-radius:10px; overflow:auto; }\ntable { width:100%; border-collapse:collapse; }\nth, td { text-align:left; padding:9px 14px; border-bottom:1px solid var(--line); white-space:nowrap; }\nth { font-size:12px; text-transform:uppercase; letter-spacing:.5px; color:#5b6674; cursor:pointer; user-select:none; background:#fbfaf6; }\nth.sorted::after { content:\" ▾\"; color:var(--amber); }\nth.sorted.asc::after { content:\" ▴\"; }\ntr:last-child td { border-bottom:0; }\n.lang { font-size:11px; font-weight:600; padding:2px 7px; border-radius:4px; background:#2a4a3518; color:var(--green); text-transform:uppercase; }\npre { margin:0; padding:16px; font:13px/1.5 ui-monospace, Menlo, monospace; white-space:pre-wrap; word-break:break-all; }\n.error { background:#fdecea; color:#8a1f11; border:1px solid #f3c4bd; padding:10px 14px; border-radius:8px; margin-bottom:12px; }\n.empty, .status { color:#5b6674; font-size:13px; padding:0 4px; }\n.empty { padding:16px; text-align:center; }\n.hidden { display:none !important; }\n.extra { display:grid; gap:12px; margin-bottom:18px; }\n.card-head { font-size:12px; text-transform:uppercase; letter-spacing:.5px; color:#5b6674; padding:10px 14px 4px; }\n.card-head .hint { text-transform:none; letter-spacing:0; opacity:.8; }\n.bars { display:flex; align-items:flex-end; gap:6px; padding:8px 14px 10px; }\n.bars .col { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:flex-end; font-size:11px; color:#5b6674; min-width:0; }\n.bars .col span { min-height:14px; line-height:14px; }\n.bars .bar { width:100%; max-width:28px; background:var(--green); border-radius:3px 3px 0 0; }\n.bars .col.zero .bar { background:var(--line); }\ntr.clickable { cursor:pointer; }\ntr.clickable:hover td { background:#fbfaf6; }\n.code { font-size:12px; font-weight:600; padding:2px 7px; border-radius:4px; background:#c47c2b22; color:#8a5316; }\n.inline-bar { display:inline-block; height:8px; background:var(--amber); border-radius:4px; vertical-align:middle; margin-left:8px; }\n",
 "app.js": "(() => {\n  const $ = (id) => document.getElementById(id);\n  const LABELS = { \"emails.json\": \"Landing page\", \"blog-emails.json\": \"Blog\", \"code-usages.json\": \"Code usages\" };\n\n  // Two kinds of files: signup lists (emails) and the code-usage log written by /api/getcode.\n  const KINDS = {\n    subscribers: {\n      cols: [[\"email\", \"Email\"], [\"language\", \"Lang\"], [\"subscribedAt\", \"Subscribed\"], [\"ipAddress\", \"IP\"]],\n      sort: { k: \"subscribedAt\", dir: -1 },\n      search: \"Search email or IP…\", filterAll: \"All languages\", filterKey: \"language\",\n      haystack: (r) => `${r.email} ${r.ipAddress}`,\n      csv: [\"email\", \"language\", \"subscribedAt\", \"ipAddress\"], csvName: \"konihaus-subscribers.csv\",\n    },\n    usages: {\n      cols: [[\"time\", \"Time\"], [\"code\", \"Code\"], [\"ip\", \"IP\"]],\n      sort: { k: \"time\", dir: -1 },\n      search: \"Search code or IP…\", filterAll: \"All codes\", filterKey: \"code\",\n      haystack: (r) => `${r.code} ${r.ip}`,\n      csv: [\"time\", \"code\", \"ip\"], csvName: \"konihaus-code-usages.csv\",\n    },\n  };\n\n  const state = { files: [], usages: \"code-usages.json\", current: null, data: [], json: false, sort: { ...KINDS.subscribers.sort } };\n  const kind = () => (state.current === state.usages ? KINDS.usages : KINDS.subscribers);\n\n  const fmtDate = (iso, seconds) => {\n    const d = new Date(iso);\n    return isNaN(d) ? String(iso ?? \"\") : d.toLocaleString(\"de-CH\", { dateStyle: \"medium\", timeStyle: seconds ? \"medium\" : \"short\" });\n  };\n  const pad = (n) => String(n).padStart(2, \"0\");\n  const dayKey = (d) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;\n  const cmp = (a, b) => (a < b ? -1 : a > b ? 1 : 0);\n\n  function showError(msg) { $(\"error\").textContent = msg || \"\"; $(\"error\").classList.toggle(\"hidden\", !msg); }\n\n  async function loadSources() {\n    const res = await fetch(\"/api/sources\");\n    const s = await res.json();\n    state.files = s.files;\n    state.usages = s.usages || \"code-usages.json\";\n    $(\"source\").textContent = s.mode === \"s3\" ? `S3 · ${s.bucket}` : \"Local file\";\n    $(\"files\").innerHTML = \"\";\n    s.files.forEach((f) => {\n      const b = document.createElement(\"button\");\n      b.textContent = LABELS[f] ? `${LABELS[f]} (${f})` : f;\n      b.dataset.name = f;\n      b.onclick = () => loadFile(f);\n      $(\"files\").appendChild(b);\n    });\n    if (s.files.length === 1) $(\"files\").classList.add(\"hidden\");\n    await loadFile(state.current && s.files.includes(state.current) ? state.current : s.files[0]);\n  }\n\n  async function loadFile(name) {\n    const changed = name !== state.current;\n    state.current = name;\n    if (changed) { state.sort = { ...kind().sort }; $(\"search\").value = \"\"; $(\"lang\").value = \"\"; }\n    [...$(\"files\").children].forEach((b) => b.classList.toggle(\"active\", b.dataset.name === name));\n    showError(\"\");\n    $(\"status\").textContent = \"Loading…\";\n    try {\n      const res = await fetch(\"/api/file?name=\" + encodeURIComponent(name));\n      const text = await res.text();\n      if (!res.ok) throw new Error(JSON.parse(text).error || res.statusText);\n      const parsed = JSON.parse(text);\n      state.data = Array.isArray(parsed) ? parsed : [];\n      if (!Array.isArray(parsed)) showError(\"File is valid JSON but not an array – showing raw view only.\");\n      $(\"json\").textContent = JSON.stringify(parsed, null, 2);\n\n      const kd = kind();\n      const prev = $(\"lang\").value;\n      const values = [...new Set(state.data.map((r) => r[kd.filterKey]).filter(Boolean))].sort();\n      $(\"lang\").innerHTML = \"\";\n      [[\"\", kd.filterAll], ...values.map((v) => [v, v])].forEach(([value, label]) => {\n        const o = document.createElement(\"option\"); o.value = value; o.textContent = label; $(\"lang\").appendChild(o);\n      });\n      $(\"lang\").value = values.includes(prev) ? prev : \"\";\n      render();\n    } catch (e) {\n      state.data = []; render();\n      showError(\"Could not load \" + name + \": \" + e.message);\n      $(\"status\").textContent = \"\";\n    }\n  }\n\n  function visibleRows() {\n    const kd = kind();\n    const q = $(\"search\").value.trim().toLowerCase();\n    const f = $(\"lang\").value;\n    const { k, dir } = state.sort;\n    return state.data\n      .filter((r) => (!f || r[kd.filterKey] === f) && (!q || kd.haystack(r).toLowerCase().includes(q)))\n      .sort((a, b) => cmp(String(a[k] ?? \"\"), String(b[k] ?? \"\")) * dir);\n  }\n\n  function renderStats(all, isU) {\n    let stats;\n    if (isU) {\n      const latest = all.map((r) => r.time).filter(Boolean).sort().pop();\n      stats = [[\"Visits\", all.length], [\"Unique IPs\", new Set(all.map((r) => r.ip)).size], [\"Codes\", new Set(all.map((r) => r.code)).size], [\"Latest\", latest ? fmtDate(latest) : \"–\"]];\n    } else {\n      const count = (l) => all.filter((r) => r.language === l).length;\n      const latest = all.map((r) => r.subscribedAt).sort().pop();\n      stats = [[\"Total\", all.length], [\"DE\", count(\"de\")], [\"EN\", count(\"en\")], [\"Latest\", latest ? fmtDate(latest) : \"–\"]];\n    }\n    $(\"stats\").innerHTML = \"\";\n    stats.forEach(([l, n]) => {\n      const d = document.createElement(\"div\"); d.className = \"stat\";\n      d.innerHTML = '<div class=\"n\"></div><div class=\"l\"></div>';\n      d.firstChild.textContent = n; d.lastChild.textContent = l;\n      $(\"stats\").appendChild(d);\n    });\n  }\n\n  // Per-code summary + visits per day (last 14 days) for the usage log\n  function renderUsageExtra(all) {\n    const by = new Map();\n    all.forEach((r) => {\n      const c = r.code ?? \"(none)\";\n      let e = by.get(c);\n      if (!e) by.set(c, (e = { code: c, visits: 0, ips: new Set(), first: r.time, last: r.time }));\n      e.visits++; e.ips.add(r.ip);\n      if (r.time < e.first) e.first = r.time;\n      if (r.time > e.last) e.last = r.time;\n    });\n    const rows = [...by.values()].sort((a, b) => b.visits - a.visits);\n    const max = rows.length ? rows[0].visits : 1;\n    $(\"sumRows\").innerHTML = \"\";\n    rows.forEach((e) => {\n      const tr = document.createElement(\"tr\");\n      tr.className = \"clickable\";\n      tr.title = \"Click to filter the log by this code\";\n      const td = (txt) => { const c = document.createElement(\"td\"); c.textContent = txt; return c; };\n      const codeTd = document.createElement(\"td\");\n      const pill = document.createElement(\"span\"); pill.className = \"code\"; pill.textContent = e.code; codeTd.appendChild(pill);\n      const visitsTd = td(String(e.visits));\n      const bar = document.createElement(\"span\"); bar.className = \"inline-bar\"; bar.style.width = Math.max(4, Math.round((e.visits / max) * 90)) + \"px\";\n      visitsTd.appendChild(bar);\n      tr.append(codeTd, visitsTd, td(String(e.ips.size)), td(fmtDate(e.first)), td(fmtDate(e.last)));\n      tr.onclick = () => { $(\"lang\").value = e.code; render(); };\n      $(\"sumRows\").appendChild(tr);\n    });\n    $(\"sumEmpty\").classList.toggle(\"hidden\", rows.length > 0);\n\n    const counts = new Map();\n    const today = new Date();\n    for (let i = 13; i >= 0; i--) counts.set(dayKey(new Date(today.getFullYear(), today.getMonth(), today.getDate() - i)), 0);\n    all.forEach((r) => {\n      const d = new Date(r.time);\n      if (isNaN(d)) return;\n      const key = dayKey(d);\n      if (counts.has(key)) counts.set(key, counts.get(key) + 1);\n    });\n    const peak = Math.max(1, ...counts.values());\n    $(\"dayBars\").innerHTML = \"\";\n    counts.forEach((n, key) => {\n      const col = document.createElement(\"div\"); col.className = \"col\" + (n ? \"\" : \" zero\"); col.title = `${key}: ${n} visit${n === 1 ? \"\" : \"s\"}`;\n      const num = document.createElement(\"span\"); num.textContent = n ? String(n) : \"\";\n      const b = document.createElement(\"div\"); b.className = \"bar\"; b.style.height = Math.max(2, Math.round((n / peak) * 70)) + \"px\";\n      const day = document.createElement(\"span\"); day.textContent = key.slice(8) + \".\" + key.slice(5, 7) + \".\";\n      col.append(num, b, day);\n      $(\"dayBars\").appendChild(col);\n    });\n  }\n\n  function syncExtra() {\n    $(\"usageExtra\").classList.toggle(\"hidden\", !(kind() === KINDS.usages && !state.json));\n  }\n\n  function render() {\n    const kd = kind();\n    const isU = kd === KINDS.usages;\n    const all = state.data;\n\n    renderStats(all, isU);\n\n    // header (columns depend on the file kind)\n    $(\"headRow\").innerHTML = \"\";\n    kd.cols.forEach(([key, label]) => {\n      const th = document.createElement(\"th\");\n      th.dataset.k = key; th.textContent = label;\n      th.classList.toggle(\"sorted\", key === state.sort.k);\n      th.classList.toggle(\"asc\", key === state.sort.k && state.sort.dir === 1);\n      th.onclick = () => { state.sort = { k: key, dir: state.sort.k === key ? -state.sort.dir : 1 }; render(); };\n      $(\"headRow\").appendChild(th);\n    });\n    $(\"search\").placeholder = kd.search;\n    $(\"copy\").classList.toggle(\"hidden\", isU);\n\n    const rows = visibleRows();\n    $(\"rows\").innerHTML = \"\";\n    const mk = (txt, cls) => { const td = document.createElement(\"td\"); if (cls) { const s = document.createElement(\"span\"); s.className = cls; s.textContent = txt; td.appendChild(s); } else td.textContent = txt; return td; };\n    rows.forEach((r) => {\n      const tr = document.createElement(\"tr\");\n      if (isU) tr.append(mk(fmtDate(r.time, true)), mk(r.code ?? \"\", \"code\"), mk(r.ip ?? \"\"));\n      else tr.append(mk(r.email ?? \"\"), mk(r.language ?? \"\", \"lang\"), mk(fmtDate(r.subscribedAt)), mk(r.ipAddress ?? \"\"));\n      $(\"rows\").appendChild(tr);\n    });\n    $(\"empty\").textContent = all.length ? \"No matching entries.\" : (isU ? \"No code usages recorded yet.\" : \"No entries yet.\");\n    $(\"empty\").classList.toggle(\"hidden\", rows.length > 0);\n\n    if (isU) renderUsageExtra(all);\n    syncExtra();\n    $(\"status\").textContent = state.current ? `${rows.length} of ${all.length} entries · ${state.current}` : \"\";\n  }\n\n  function setView(json) {\n    state.json = json;\n    $(\"viewTable\").classList.toggle(\"active\", !json);\n    $(\"viewJson\").classList.toggle(\"active\", json);\n    $(\"tableWrap\").classList.toggle(\"hidden\", json);\n    $(\"json\").classList.toggle(\"hidden\", !json);\n    $(\"tableTools\").classList.toggle(\"hidden\", json);\n    $(\"copyJson\").classList.toggle(\"hidden\", !json);\n    syncExtra();\n  }\n\n  const flash = (btn, txt) => { const o = btn.textContent; btn.textContent = txt; setTimeout(() => (btn.textContent = o), 1200); };\n\n  $(\"viewTable\").onclick = () => setView(false);\n  $(\"viewJson\").onclick = () => setView(true);\n  $(\"refresh\").onclick = loadSources;\n  $(\"search\").oninput = $(\"lang\").onchange = render;\n  $(\"copy\").onclick = async () => {\n    await navigator.clipboard.writeText(visibleRows().map((r) => r.email).join(\"\\n\"));\n    flash($(\"copy\"), \"Copied ✓\");\n  };\n  $(\"copyJson\").onclick = async () => { await navigator.clipboard.writeText($(\"json\").textContent); flash($(\"copyJson\"), \"Copied ✓\"); };\n  $(\"csv\").onclick = () => {\n    const kd = kind();\n    const esc = (v) => `\"${String(v ?? \"\").replace(/\"/g, '\"\"')}\"`;\n    const csv = [kd.csv.join(\",\"), ...visibleRows().map((r) => kd.csv.map((key) => esc(r[key])).join(\",\"))].join(\"\\n\");\n    const a = document.createElement(\"a\");\n    a.href = URL.createObjectURL(new Blob([csv], { type: \"text/csv\" }));\n    a.download = kd.csvName;\n    a.click();\n  };\n\n  loadSources().catch((e) => showError(\"Cannot reach local server: \" + e.message));\n})();\n"
};

function send(res, status, body, type = "application/json") {
  res.writeHead(status, { "Content-Type": type + "; charset=utf-8", "Cache-Control": "no-store" });
  res.end(body);
}

http.createServer(async (req, res) => {
  const url = new URL(req.url, "http://localhost");

  // Endpoint 1: which source + which files
  if (url.pathname === "/api/sources") {
    return send(res, 200, JSON.stringify({ mode: MODE, bucket: BUCKET || null, files: FILES, usages: USAGES_FILE }));
  }

  // Endpoint 2: raw content of one whitelisted file
  if (url.pathname === "/api/file") {
    const name = url.searchParams.get("name");
    if (!FILES.includes(name)) return send(res, 404, JSON.stringify({ error: "Unknown file" }));
    try {
      return send(res, 200, await readFile(name));
    } catch (err) {
      // No usages logged yet (file not created) is not an error
      if (name === USAGES_FILE && (err.name === "NoSuchKey" || err.code === "ENOENT")) return send(res, 200, "[]");
      return send(res, 502, JSON.stringify({ error: `${MODE} read failed: ${err.name || "Error"} – ${err.message}` }));
    }
  }

  // Static UI (embedded)
  const rel = url.pathname === "/" ? "index.html" : url.pathname.slice(1);
  if (!Object.hasOwn(ASSETS, rel)) return send(res, 404, "Not found", "text/plain");
  send(res, 200, ASSETS[rel], MIME[path.extname(rel)]);
}).listen(PORT, "127.0.0.1", () => {
  console.log(`Konihaus subscribers → http://localhost:${PORT}  (source: ${MODE}${BUCKET ? " / " + BUCKET : ""})`);
});
